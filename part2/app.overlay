{    external_leds { 
    compatible = "gpio-leds"; 
    external_led: led_4 { 
        gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>; 
        label = "External LED"; 
    };
};
    external_switches { 
    compatible = "gpio-keys"; 
    external_switch: switch_0 { 
        gpios = <&gpio1 23 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; 
        label = "External Switch";
     };
   };
};
